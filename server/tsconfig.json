{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "Node",
    "module": "CommonJS",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/tests/**",
    "src/services/race.service.ts",
    "src/services/session.service.ts",
    "src/session/**",
    "src/services/messageQueue.service.ts",
    "src/controllers/race.controller.ts",
    "src/routes/race.routes.ts"
  ],
  "references": [
    { "path": "../shared" }
  ]
}
